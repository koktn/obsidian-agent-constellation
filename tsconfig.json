{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2020",
		"allowJs": true,
		"noImplicitAny": true,
		"strict": true,
		"moduleResolution": "Bundler",
		"importHelpers": false,
		"isolatedModules": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"lib": ["DOM", "ES2020", "ES2021.String"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
